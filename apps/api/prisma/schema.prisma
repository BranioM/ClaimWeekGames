generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  connectedAccounts       ConnectedAccount[]
  accountConnectionStates AccountConnectionState[]
  sessions                UserSession[]
}

model UserSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt, expiresAt])
}

model Store {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  connectedAccounts       ConnectedAccount[]
  accountConnectionStates AccountConnectionState[]
  externalGameIds         ExternalGameId[]
  offers                  FreeGameOffer[]
  syncJobs                SyncJob[]
}

model Game {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  developer String?
  publisher String?
  createdAt DateTime @default(now())

  externalIds ExternalGameId[]
  ownerships  Ownership[]
  offers      FreeGameOffer[]
}

model ExternalGameId {
  id             String   @id @default(cuid())
  providerGameId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gameId  String
  storeId String

  game  Game  @relation(fields: [gameId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, providerGameId])
}

model ConnectedAccount {
  id                String                 @id @default(cuid())
  accountKey        String
  externalAccountId String?
  displayName       String?
  status            ConnectedAccountStatus @default(ACTIVE)
  lastSyncedAt      DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  userId  String
  storeId String

  user       User        @relation(fields: [userId], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])
  ownerships Ownership[]

  @@unique([userId, storeId, accountKey])
  @@unique([storeId, externalAccountId])
}

model AccountConnectionState {
  id         String    @id @default(cuid())
  stateHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([userId, storeId, consumedAt, expiresAt])
}

enum ConnectedAccountStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  REVOKED
}

model Ownership {
  id         String   @id @default(cuid())
  acquiredAt DateTime @default(now())

  connectedAccountId String
  gameId             String

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id])
  game             Game             @relation(fields: [gameId], references: [id])

  @@unique([connectedAccountId, gameId])
}

model FreeGameOffer {
  id              String   @id @default(cuid())
  externalOfferId String?
  startDate       DateTime
  endDate         DateTime
  detectedAt      DateTime @default(now())

  gameId  String
  storeId String

  game  Game  @relation(fields: [gameId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, externalOfferId])
  @@unique([gameId, storeId, startDate, endDate])
}

model SyncJob {
  id           String        @id @default(cuid())
  jobType      String
  status       SyncJobStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  storeId String?

  store Store? @relation(fields: [storeId], references: [id])

  @@index([status, createdAt])
  @@index([storeId, jobType, createdAt])
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}
