generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  connectedAccounts ConnectedAccount[]
}

model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  connectedAccounts ConnectedAccount[]
  externalGameIds ExternalGameId[]
  offers          FreeGameOffer[]
}

model Game {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  developer String?
  publisher String?
  createdAt DateTime @default(now())

  externalIds ExternalGameId[]
  ownerships  Ownership[]
  offers      FreeGameOffer[]
}

model ExternalGameId {
  id             String   @id @default(cuid())
  providerGameId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gameId     String
  platformId String

  game     Game     @relation(fields: [gameId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([platformId, providerGameId])
}

model ConnectedAccount {
  id                String   @id @default(cuid())
  accountKey        String
  externalAccountId String?
  displayName       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId     String
  platformId String

  user       User        @relation(fields: [userId], references: [id])
  platform   Platform    @relation(fields: [platformId], references: [id])
  ownerships Ownership[]

  @@unique([userId, platformId, accountKey])
  @@unique([platformId, externalAccountId])
}

model Ownership {
  id         String   @id @default(cuid())
  acquiredAt DateTime @default(now())

  connectedAccountId String
  gameId             String

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id])
  game             Game             @relation(fields: [gameId], references: [id])

  @@unique([connectedAccountId, gameId])
}

model FreeGameOffer {
  id              String   @id @default(cuid())
  externalOfferId String?
  startDate       DateTime
  endDate         DateTime
  detectedAt      DateTime @default(now())

  gameId     String
  platformId String

  game     Game     @relation(fields: [gameId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([platformId, externalOfferId])
  @@unique([gameId, platformId, startDate, endDate])
}
